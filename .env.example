# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# LLM provider for the reason-code + agent layer (provider-agnostic interface).
# Default: Gemini free tier (no card needed). Alternatives: groq | ollama | openai.
AXIOM_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here        # https://aistudio.google.com -> "Get API key"
AXIOM_GEMINI_MODEL=gemini-2.5-flash

# Optional fallbacks / final-demo model
# GROQ_API_KEY=
# OPENAI_API_KEY=                          # reserve the ~$2.44 for the final demo only

# Service
API_HOST=127.0.0.1
API_PORT=8000

# Paths
DATA_DIR=./data
MODEL_DIR=./models
AUDIT_DB=./audit.sqlite
CHROMA_DIR=./.chroma

# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# LLM provider for the reason-code + agent layer (provider-agnostic interface).
# Default: Gemini free tier (no card needed). Alternatives: groq | ollama | openai.
AXIOM_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here        # https://aistudio.google.com -> "Get API key"
AXIOM_GEMINI_MODEL=gemini-2.5-flash

# Real actions — Razorpay TEST mode (free, no KYC): Dashboard > Account & Settings > API Keys (Test)
RAZORPAY_ENABLED=0
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# Cross-vendor verifier (optional): an independent model second-checks the agent's decision
OPENAI_API_KEY=sk-...
AXIOM_VERIFIER_PROVIDER=none              # openai | gemini | none
AXIOM_OPENAI_MODEL=gpt-4o-mini

# Service
API_HOST=127.0.0.1
API_PORT=8000

# Paths
DATA_DIR=./data
MODEL_DIR=./models
AUDIT_DB=./audit.sqlite
CHROMA_DIR=./.chroma

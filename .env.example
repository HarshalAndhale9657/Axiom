# Copy to .env and fill in. NEVER commit .env.

# Anthropic (Claude Agent SDK) — required for the agent + reason-code layers
ANTHROPIC_API_KEY=sk-ant-...

# Model routing (latest models)
AXIOM_AGENT_MODEL=claude-opus-4-8       # hard investigation reasoning
AXIOM_FAST_MODEL=claude-sonnet-4-6      # reason-code generation / workhorse

# Service
API_HOST=127.0.0.1
API_PORT=8000

# Paths
DATA_DIR=./data
MODEL_DIR=./models
AUDIT_DB=./audit.sqlite
CHROMA_DIR=./.chroma
